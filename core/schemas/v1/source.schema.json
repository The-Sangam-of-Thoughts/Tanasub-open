{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://creative-writing-library.local/schemas/v1/source.schema.json",
  "title": "Research Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "creators", "source_type", "source_roles", "reliability_tier", "publication", "languages", "regions", "access", "verification", "axis_ids", "claim_ids", "translation", "copyright"],
  "properties": {
    "id": {"type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "creators": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "source_type": {"enum": ["primary-work", "manuscript", "authorised-script", "author-essay", "lecture", "diary", "interview", "peer-reviewed-article", "scholarly-book", "critical-edition", "literary-history", "professional-criticism", "long-form-review", "craft-book", "editor-essay", "teacher-resource", "practitioner-essay", "reader-response", "audience-response", "library-vocabulary", "archival-record", "publisher-classification", "bookseller-classification", "industry-classification", "community-documentation", "other"]},
    "source_roles": {"type": "array", "items": {"enum": ["recognition", "definition", "history", "craft-support", "counterevidence", "reception", "translation", "indian-context", "screen-adaptation", "corpus-warrant"]}, "minItems": 1, "uniqueItems": true},
    "reliability_tier": {"type": "integer", "minimum": 1, "maximum": 5},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher_or_container", "published_date", "edition", "doi", "isbn"],
      "properties": {
        "publisher_or_container": {"type": ["string", "null"], "minLength": 1},
        "published_date": {
          "oneOf": [
            {"type": "string", "pattern": "^\\d{4}$"},
            {"type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"},
            {"type": "string", "pattern": "^(?:(?:\\d{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)$", "format": "date"},
            {"type": "null"}
          ]
        },
        "edition": {"type": ["string", "null"], "minLength": 1},
        "doi": {"type": ["string", "null"], "minLength": 1},
        "isbn": {"type": ["string", "null"], "minLength": 10}
      }
    },
    "languages": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"}, "minItems": 1, "uniqueItems": true},
    "regions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "accessed_at", "access_conditions"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date"},
        "access_conditions": {"enum": ["open", "licensed", "library", "purchased", "limited-preview", "unavailable"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_directly", "verified_at", "verified_by", "verification_notes"],
      "properties": {
        "verified_directly": {"const": true},
        "verified_at": {"type": "string", "format": "date-time"},
        "verified_by": {"type": "string", "minLength": 1},
        "verification_notes": {"type": "string", "minLength": 1}
      }
    },
    "axis_ids": {"type": "array", "items": {"type": "string", "pattern": "^axis-[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^clm-[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_translation", "original_language", "translator", "limitations"],
      "properties": {
        "is_translation": {"type": "boolean"},
        "original_language": {"type": ["string", "null"], "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "translator": {"type": ["string", "null"], "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "copyright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository_copy_allowed", "notes"],
      "properties": {
        "status": {"enum": ["public-domain", "licensed", "copyrighted", "unknown"]},
        "repository_copy_allowed": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
