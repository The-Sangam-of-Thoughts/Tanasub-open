{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://creative-writing-library.local/schemas/v1/primary-work.schema.json",
  "title": "Primary Creative Work",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "creators", "work_type", "published_date", "languages", "regions", "axis_ids", "period_role", "source_id", "access", "analysis_status", "mechanics"],
  "properties": {
    "id": {"type": "string", "pattern": "^work-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "creators": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "work_type": {"enum": ["novel", "novella", "short-story", "memoir", "poem", "play", "screenplay", "feature-film", "television", "audio", "interactive-writing", "oral-performance", "other"]},
    "published_date": {
      "oneOf": [
        {"type": "string", "pattern": "^\\d{4}$"},
        {"type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"},
        {"type": "string", "pattern": "^(?:(?:\\d{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)$", "format": "date"},
        {"type": "null"}
      ]
    },
    "languages": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"}, "minItems": 1, "uniqueItems": true},
    "regions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "axis_ids": {"type": "array", "items": {"type": "string", "pattern": "^axis-[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "period_role": {"enum": ["formative", "recognized", "contemporary", "other"]},
    "source_id": {"type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_or_version", "language_used", "translator", "access_conditions"],
      "properties": {
        "edition_or_version": {"type": "string", "minLength": 1},
        "language_used": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "translator": {"type": ["string", "null"], "minLength": 1},
        "access_conditions": {"enum": ["open", "licensed", "library", "purchased", "limited-preview", "unavailable"]}
      }
    },
    "analysis_status": {"enum": ["not-started", "in-progress", "complete", "revision-required"]},
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["premise", "reader_promise", "opening", "point_of_view", "character_system", "conflict_and_stakes", "structure", "scene_movement", "dialogue", "setting", "style_and_devices", "emotional_progression", "suspense_or_anticipation", "climax", "ending", "conventions", "innovation_or_subversion", "critical_reception", "audience_reception"],
      "properties": {
        "premise": {"$ref": "#/definitions/analysisText"},
        "reader_promise": {"$ref": "#/definitions/analysisText"},
        "opening": {"$ref": "#/definitions/analysisText"},
        "point_of_view": {"$ref": "#/definitions/analysisText"},
        "character_system": {"$ref": "#/definitions/analysisText"},
        "conflict_and_stakes": {"$ref": "#/definitions/analysisText"},
        "structure": {"$ref": "#/definitions/analysisText"},
        "scene_movement": {"$ref": "#/definitions/analysisText"},
        "dialogue": {"$ref": "#/definitions/analysisText"},
        "setting": {"$ref": "#/definitions/analysisText"},
        "style_and_devices": {"$ref": "#/definitions/analysisText"},
        "emotional_progression": {"$ref": "#/definitions/analysisText"},
        "suspense_or_anticipation": {"$ref": "#/definitions/analysisText"},
        "climax": {"$ref": "#/definitions/analysisText"},
        "ending": {"$ref": "#/definitions/analysisText"},
        "conventions": {"$ref": "#/definitions/analysisText"},
        "innovation_or_subversion": {"$ref": "#/definitions/analysisText"},
        "critical_reception": {"$ref": "#/definitions/analysisText"},
        "audience_reception": {"$ref": "#/definitions/analysisText"}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "analysis_status": {"enum": ["not-started", "in-progress", "revision-required"]}
      }
    },
    {
      "properties": {
        "analysis_status": {"const": "complete"},
        "mechanics": {
          "properties": {
              "premise": {"type": "string", "minLength": 1},
              "reader_promise": {"type": "string", "minLength": 1},
              "opening": {"type": "string", "minLength": 1},
              "point_of_view": {"type": "string", "minLength": 1},
              "character_system": {"type": "string", "minLength": 1},
              "conflict_and_stakes": {"type": "string", "minLength": 1},
              "structure": {"type": "string", "minLength": 1},
              "scene_movement": {"type": "string", "minLength": 1},
              "dialogue": {"type": "string", "minLength": 1},
              "setting": {"type": "string", "minLength": 1},
              "style_and_devices": {"type": "string", "minLength": 1},
              "emotional_progression": {"type": "string", "minLength": 1},
              "suspense_or_anticipation": {"type": "string", "minLength": 1},
              "climax": {"type": "string", "minLength": 1},
              "ending": {"type": "string", "minLength": 1},
              "conventions": {"type": "string", "minLength": 1},
              "innovation_or_subversion": {"type": "string", "minLength": 1},
              "critical_reception": {"type": "string", "minLength": 1},
              "audience_reception": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ],
  "definitions": {
    "analysisText": {"type": ["string", "null"], "minLength": 1}
  }
}
